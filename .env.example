# Twitch bot account login (without #)
TWITCH_USERNAME=

# OAuth token for the bot account (with or without oauth: prefix).
# Scopes required: chat:read chat:edit
# See README "Your steps" for how to generate this while logged in as the bot.
TWITCH_OAUTH_TOKEN=

# Comma-separated channels to join (without #). Usually your streamer login.
TWITCH_CHANNELS=

# Optional: command prefix (default !eql)
# TWITCH_PREFIX=!eql

# Optional: ms between bot replies in the same channel (default 2500)
# TWITCH_COOLDOWN_MS=2500

# Optional: durable data directory (default ./data). Docker sets DATA_DIR=/app/data.
# DATA_DIR=./data

# Optional: path to usage counters JSON (default $DATA_DIR/usage.json)
# USAGE_DB_PATH=./data/usage.json

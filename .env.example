# Twitch bot account login (without #)
TWITCH_USERNAME=

# OAuth token for the bot account (with or without oauth: prefix).
# Scopes required: chat:read chat:edit
# See README "Your steps" for how to generate this while logged in as the bot.
TWITCH_OAUTH_TOKEN=

# Bootstrap channels (without #). Merged into data/channels.json on boot.
# Self-serve installs append to that file; this env is mainly for first deploy.
TWITCH_CHANNELS=

# Twitch application (Developer Console) — required for self-serve add/remove
# on norrathroster.com. Redirect URL must include:
#   https://norrathroster.com/api/twitch-bot/oauth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: override install OAuth callback / result URLs
# TWITCH_INSTALL_REDIRECT_URI=https://norrathroster.com/api/twitch-bot/oauth/callback
# TWITCH_INSTALL_RESULT_URL=https://norrathroster.com/twitch-bot

# Optional: install HTTP port inside the container (default 3911)
# JOIN_API_PORT=3911

# Optional: command prefix (default !eqlwiki)
# TWITCH_PREFIX=!eqlwiki

# Optional: ms between bot replies in the same channel (default 2500)
# TWITCH_COOLDOWN_MS=2500

# Optional: hourly rotating tips in live channels (needs CLIENT_ID/SECRET).
# Default rotates roster promo + bot intro. Interval default 3600000 (1h).
# PROMO_ENABLED=true
# PROMO_INTERVAL_MS=3600000
# PROMO_MESSAGE=Create and view character sheets at https://norrathroster.com — look one up anytime with !roster <name> <server>

# Optional: durable data directory (default ./data). Docker sets DATA_DIR=/app/data.
# DATA_DIR=./data

# Optional: path to usage counters JSON (default $DATA_DIR/usage.json)
# USAGE_DB_PATH=./data/usage.json

# Optional: durable channel list (default $DATA_DIR/channels.json)
# CHANNELS_FILE=./data/channels.json

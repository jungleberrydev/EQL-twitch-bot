# Twitch bot account login (without #)
TWITCH_USERNAME=your_bot_login

# OAuth token for the bot account (with or without oauth: prefix).
# Generate at https://twitchtokengenerator.com/ (chat:read + chat:edit)
# or via a Twitch app with the chat:read / chat:edit scopes.
TWITCH_OAUTH_TOKEN=

# Comma-separated channels to join (without #)
TWITCH_CHANNELS=your_channel

# Optional: command prefix (default !eql)
# TWITCH_PREFIX=!eql

# Optional: ms between bot replies in the same channel (default 2500)
# TWITCH_COOLDOWN_MS=2500

{
  "name": "eql-twitch-bot",
  "version": "1.4.0",
  "description": "Twitch chat bot for EQLwiki lookups (!eqlwiki item, mob, zone, spell, faction)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/tmi.js": "^1.8.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
